{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-node",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src-node/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist-node"]
}

