{
  "name": "citydatebot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "node --import tsx --watch src-node/index.ts",
    "start": "node dist-node/src-node/index.js",
    "db:migrate": "node scripts/run-module.mjs dist-node/src-node/db/migrate.js src-node/db/migrate.ts",
    "db:import": "node scripts/run-module.mjs dist-node/src-node/import/importCsv.js src-node/import/importCsv.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@grammyjs/types": "^3.27.3",
    "better-sqlite3": "^12.5.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.2",
    "grammy": "^1.38.5",
    "pino": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22"
  }
}
